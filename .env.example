# ==============================================================================
# Al-Souq (السوق) – Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=production

# Application Base URL (e.g. https://al-souq.vercel.app or http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication & Session Token Secret (min 32 characters)
SESSION_SECRET=alsouq_super_secret_session_token_key_min_32_characters_random

# Empty Database Mode (Set to true to deploy with clean slate: 0 posts, 0 listings)
EMPTY_DATABASE=true
NEXT_PUBLIC_EMPTY_DATABASE=true

# Initial Admin Credentials (used when database is empty)
ADMIN_EMAIL=admin@alsouq.community
ADMIN_PASSWORD=Admin@AlSouq2026

# Database Connection (Neon / Supabase Serverless PostgreSQL - 100% Free)
# Neon connection string format:
# DATABASE_URL=postgresql://neondb_owner:npg_xyz@ep-fancy-pond.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://alsouq_user:alsouq_password@localhost:5432/alsouq_db?schema=public

# Optional: Cloudflare R2 / AWS S3 Presigned Uploads (100% Free 10GB on Cloudflare R2)
S3_BUCKET_NAME=alsouq-media
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_PUBLIC_DOMAIN=https://media.alsouq.community

# Authentication Provider Wrapper ('local' | 'cognito' - future AWS Cognito drop-in)
AUTH_PROVIDER=local

# Redis OTP Store (Upstash Serverless Redis REST API - 100% Free Tier)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Free Email Service for Forgot Password OTP (Resend or Brevo)
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FROM=Al-Souq Security <onboarding@resend.dev>
